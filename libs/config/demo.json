{
"sim":
{
    "size":[100,100,50],
    "periodicity" : "xy",
    "dtype":"uint8",
    "render":false,
    "max_steps":50
},

"tracker": {
  "name": "StateTracker",
  "args": {},
  "save_as": "demo"
},

"state_keys":[
    {
        "name":"substrate",
        "layers":6,
        "dtype":"np.uint8",
        "random":true,
        "random_func":"np.random.choice",
        "random_args":
        {
            "a" : [0,1],
            "p" : [0.999,0.001]
        }
    },
    {
        "name":"bacteria",
        "layers":1,
        "dtype":"np.uint8",
        "random":true,
        "random_func" : "init_block",
        "random_args" : 
        {
            "start":[50,50,0],
            "block_size":[3,3,3],
            "value":1
        } 
    }
],

"rules":[
    {
        "name":"Diffusion",
        "args" : 
        {
            "time_step" : 0.01,
            "target_key":"substrate",
            "a" : 7.4,
            "p" : 0.07
        }
        
    },
    {
        "name" : "Utilization",
        "args" : {
            "time_step" : 0.01,
            "bacteria_keys" : ["bacteria"],
            "substrate_key" : "substrate",
            "substitute_constant" : 0.37,
            "Ks" : 10,
            "Sb" : 15
        }
    },
    {
        "name" : "BacteriaGrowth",
        "args" : {
            "time_step" : 43200,
            "time_scale" : 4319999,
            "bacteria_keys" : ["bacteria"],
            "substrate_key" : "substrate",
            "Yca" : 6.94e-6,
            "base_prob" : 0.02 
        }
    },
    {
        "name":"Inoculation",
        "args" :
        {
            "time_step" : 10000,
            "target_key":"substrate",
            "location" : [1,1,1],
            "size" : [3,3,3]
        }

    }
],

"renderer":
{
    "key":"bacteria",
    "window_size":[1200,800],
    "callback" :
    {
        "name":"Callback",
        "args":
        {
            "step_stride":1
        }
    }
}
}