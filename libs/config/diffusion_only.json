{
"sim":
{
    "size":[50,50,50],
    "periodicity" : "",
    "dtype":"uint8",
    "render":false,
    "max_steps":1000
},
"tracker": {
  "name": "StateTracker",
  "args": {},
  "save_as": "diff"
},

"state_keys":[
    {
        "name":"substrate",
        "layers":6,
        "dtype":"np.uint8",
        "random":true,
        "random_func" : "init_block",
        "random_args" : 
        {
            "start":[0,0,0],
            "block_size":[1,2,4],
            "value":1
        } 
    }
],

"rules":[
    {
        "name":"Diffusion",
        "args" : 
        {
            "time_step" : 0.01,
            "target_key":"substrate",
            "a" : 7.4,
            "p" : 0.07
        }
        
    },
    {
        "name":"Inoculation",
        "args" :
        {
            "time_step" : 0.1,
            "target_key":"substrate",
            "location" : [1,1,1],
            "size" : [3,3,3]
        }

    }
],

"renderer":
{
    "key":"substrate",
    "window_size":[1200,800],
    "callback" :
    {
        "name":"ReduceCallback",
        "args":
        {
            "step_stride":1
        }
    }
}
}