{
"sim":
{
    "size": [40, 40, 10],
    "periodicity": "xy",
    "dtype": "uint8",
    "render": false,
    "max_steps": 30
},

"tracker": {
  "name": "StateTracker",
  "args": {},
  "save_as": "multispecies_experiment"
},

"state_keys": [
    {
        "name": "substrate",
        "layers": 1,
        "dtype": "np.uint8",
        "random": true,
        "random_func": "np.random.choice",
        "random_args":
        {
            "a": [0, 1],
            "p": [0.2, 0.8]
        }
    },
    {
        "name": "bact_red",
        "layers": 1,
        "dtype": "np.uint8",
        "random": true,
        "random_func": "np.random.choice",
        "random_args":
        {
            "a": [0, 1],
            "p": [0.99, 0.01]
        }
    },
    {
        "name": "bact_green",
        "layers": 1,
        "dtype": "np.uint8",
        "random": true,
        "random_func": "np.random.choice",
        "random_args":
        {
            "a": [0, 1],
            "p": [0.99, 0.01]
        }
    },
    {
        "name": "bact_blue",
        "layers": 1,
        "dtype": "np.uint8",
        "random": true,
        "random_func": "np.random.choice",
        "random_args":
        {
            "a": [0, 1],
            "p": [0.99, 0.01]
        }
    }
],

"rules": [
    {
        "name": "SpeciesInteraction",
        "args": 
        {
            "time_step": 1.0,
            "interactions": 
            {
                "bact_red": {"bact_green": -0.5, "bact_blue": 0.2},
                "bact_green": {"bact_blue": -0.5, "bact_red": 0.2},
                "bact_blue": {"bact_red": -0.5, "bact_green": 0.2}
            },
            "spawn_claim_scale": 1.0
        }
    },
    {
        "name": "BacteriaGrowth",
        "args": 
        {
            "time_step": 1.0,
            "time_scale": 1.0,
            "bacteria_keys": ["bact_red", "bact_green", "bact_blue"],
            "substrate_key": "substrate",
            "Yca": 0.6,
            "base_prob": 0.9 
        }
    }
],

"renderer":
{
    "key": ["bact_red", "bact_green", "bact_blue"],
    "window_size": [1200, 800],
    "callback":
    {
        "name": "MultiKeyCallback",
        "args":
        {
            "step_stride": 1
        }
    }
}
}